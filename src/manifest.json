{
  "manifest_version": 3,
  "name": "flAx",
  "version": "0.1.0",
  "description": "axe-core-based accessibility inspector",
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/axe.min.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}