{
  "manifest_version": 3,
  "name": "flax",
  "version": "1.0.0",
  "description": "axe-core-based accessibility inspector",
  "icons": {
    "16": "assets/flax-icon-16.png",
    "32": "assets/flax-icon-32.png",
    "48": "assets/flax-icon-48.png",
    "128": "assets/flax-icon-128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/axe.min.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "flax@parallaxe-a.ca",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}